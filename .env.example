# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# At least 32 characters, e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=
# The first administrator, created on first start only. Change the password after signing in.
ADMIN_USERNAME=administrator
ADMIN_EMAIL=administrator@example.com
ADMIN_PASSWORD=
# true = also create a demo company, branches and departments
SEED_SAMPLE_DATA=false
WEB_PORT=8080
